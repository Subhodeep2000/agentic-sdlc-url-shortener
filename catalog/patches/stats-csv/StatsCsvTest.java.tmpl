package com.acme.shortener;

import static com.acme.testkit.Assert.assertEquals;
import static com.acme.testkit.Assert.assertTrue;

import com.acme.testkit.Test;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.time.Clock;
import java.util.Map;

public class StatsCsvTest {

    @Test
    public void neutralisesFormulaTriggersAndQuotesSpecials() {
        assertEquals("'=1+1", StatsCsv.cell("=1+1"));
        assertEquals("'+cmd", StatsCsv.cell("+cmd"));
        assertEquals("'-2", StatsCsv.cell("-2"));
        assertEquals("'@SUM(A1)", StatsCsv.cell("@SUM(A1)"));
        assertEquals("\"a,b\"", StatsCsv.cell("a,b"));
        assertEquals("\"say \"\"hi\"\"\"", StatsCsv.cell("say \"hi\""));
        assertEquals("plain.example.com", StatsCsv.cell("plain.example.com"));
    }

    @Test
    public void rendersTotalDayAndReferrerRows() {
        LinkService.Stats s = new LinkService.Stats("c", 3, null, Map.of("2026-03-01", 3L), Map.of("=evil", 2L, "ok.com", 1L));
        String csv = StatsCsv.render(s);
        assertTrue(csv.startsWith("section,key,count\r\n"), csv);
        assertTrue(csv.contains("total,all,3\r\n"), csv);
        assertTrue(csv.contains("day,2026-03-01,3\r\n"), csv);
        assertTrue(csv.contains("referrer,'=evil,2\r\n"), csv);
    }

    @Test
    public void httpEndpointServesCsv() throws Exception {
        Clock clock = Clock.systemUTC();
        LinkService svc = new LinkService(clock, "http://x", 100);
        svc.create("https://example.com/p", "csv-link", null);
        svc.resolve("csv-link", "https://ref.example.org/a");
        ShortenerServer server = new ShortenerServer(svc, new RateLimiter(10, 10, clock), new RateLimiter(10, 10, clock));
        server.start(0);
        try {
            HttpResponse<String> r = HttpClient.newHttpClient().send(HttpRequest.newBuilder(
                    URI.create("http://127.0.0.1:" + server.port() + "/api/v1/links/csv-link/stats.csv")).build(),
                    HttpResponse.BodyHandlers.ofString());
            assertEquals(200, r.statusCode());
            assertTrue(r.headers().firstValue("Content-Type").orElse("").startsWith("text/csv"), "content type");
            assertTrue(r.body().contains("referrer,ref.example.org,1"), r.body());
        } finally {
            server.stop();
        }
    }
}
