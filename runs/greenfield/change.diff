+        svc.resolve("csv-link", "https://ref.example.org/a");
+        ShortenerServer server = new ShortenerServer(svc, new RateLimiter(10, 10, clock), new RateLimiter(10, 10, clock));
+        server.start(0);
+        try {
+            HttpResponse<String> r = HttpClient.newHttpClient().send(HttpRequest.newBuilder(
+                    URI.create("http://127.0.0.1:" + server.port() + "/api/v1/links/csv-link/stats.csv")).build(),
+                    HttpResponse.BodyHandlers.ofString());
+            assertEquals(200, r.statusCode());
+            assertTrue(r.headers().firstValue("Content-Type").orElse("").startsWith("text/csv"), "content type");
+            assertTrue(r.body().contains("referrer,ref.example.org,1"), r.body());
